# EditorConfig is awesome: https://EditorConfig.org

root = true

# Global settings across all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_size = 4

# Shell scripts and batch files
[*.sh]
end_of_line = lf

[*.{cmd,bat,ps1}]
end_of_line = crlf

# Markdown files (allow trailing spaces for line breaks)
[*.md]
trim_trailing_whitespace = false
