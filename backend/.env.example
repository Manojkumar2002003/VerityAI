# ==============================================================================
# VerityAI Backend Environment Configuration
# ==============================================================================

# Application Identity
APP_NAME="VerityAI API"
API_VERSION="0.1.0"
ENVIRONMENT="development"

# Routing Prefix
API_V1_PREFIX="/api/v1"

# CORS Configuration (JSON array or comma-separated list of origins)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# Logging
LOG_LEVEL="INFO"

# Database Configuration (SQLite default in dedicated ./data/ directory)
DATABASE_URL="sqlite:///./data/verityai.db"
